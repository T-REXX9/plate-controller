# Keep this at 0 until all sensor contacts and protected outputs are wired.
GATE_MODE=0
GATE_GPIO_CHIP=/dev/gpiochip0

# BCM GPIO numbering (not physical header-pin numbering).
GATE_LOOP_GPIO=17
GATE_PASSAGE_GPIO=27
GATE_TRAFFIC_GPIO=22
GATE_OPEN_GPIO=23
GATE_CLOSE_GPIO=24
# Optional long-range RFID: UART uses physical pins 8/10 through a proper
# RS-232-to-3.3 V TTL converter. Inventory is requested over the serial link.
RFID_ENABLED=0
RFID_SERIAL_DEVICE=/dev/serial0
RFID_BAUD_RATE=9600
RFID_PROTOCOL=uhfreader18
RFID_READ_TIMEOUT_MS=5000
RFID_MIN_LENGTH=4
RFID_MAX_LENGTH=64
# UHFReader18 responses are framed; EPC length is read from each valid frame.
RFID_TAG_BYTES=0
CAMERA_STATUS_LED_GPIO=25
SERVER_STATUS_LED_GPIO=5
LOOP_STATUS_LED_GPIO=6
BARRIER_OPEN_STATUS_LED_GPIO=12
PLATE_UNRECOGNIZED_LED_GPIO=13

# Inputs use internal pull-ups: open/HIGH = inactive, grounded/LOW = active.
# OPEN/CLOSE idle HIGH and one pulses LOW at a time. Traffic LOW=red, HIGH=green.
# All status LEDs are active-high: LOW=off, HIGH=on.
GATE_INPUT_DEBOUNCE_MS=300
GATE_RELAY_PULSE_MS=1000
GATE_RECOGNITION_TIMEOUT_MS=20000
GATE_OPENING_TRAVEL_MS=3000
GATE_PASSAGE_TIMEOUT_MS=30000
GATE_CLEARANCE_MS=1500
GATE_CLOSING_TRAVEL_MS=3000
